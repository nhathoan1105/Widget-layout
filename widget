import 'package:flutter/material.dart';
import 'product.dart';
import 'cart_item_widget.dart';
import 'product_card_widget.dart';

class ShoeStoreScreen extends StatefulWidget {
  const ShoeStoreScreen({Key? key}) : super(key: key);

  @override
  State<ShoeStoreScreen> createState() => _ShoeStoreScreenState();
}

class _ShoeStoreScreenState extends State<ShoeStoreScreen> {
  // Danh sách sản phẩm cửa hàng
  final List<Product> _products = [
    Product(
      id: '1',
      name: 'Nike Air Max',
      price: 120.0,
      imageUrl: 'https://via.placeholder.com/150',
    ),
    Product(
      id: '2',
      name: 'Adidas Ultraboost',
      price: 150.0,
      imageUrl: 'https://via.placeholder.com/150',
    ),
    Product(
      id: '3',
      name: 'Puma RS-X',
      price: 100.0,
      imageUrl: 'https://via.placeholder.com/150',
    ),
    Product(
      id: '4',
      name: 'Nike Air Max 2',
      price: 120.0,
      imageUrl: 'https://via.placeholder.com/150',
    ),
  ];

  // Danh sách giỏ hàng
  final List<Product> _cartList = [];

  // Thêm vào giỏ hàng (Xử lý tăng số lượng nếu trùng)
  void _addToCart(Product product) {
    setState(() {
      int index = _cartList.indexWhere((item) => item.id == product.id);
      if (index != -1) {
        _cartList[index].quantity += 1;
      } else {
        _cartList.add(
          Product(
            id: product.id,
            name: product.name,
            price: product.price,
            imageUrl: product.imageUrl,
            quantity: 1,
          ),
        );
      }
    });
  }

  // Xóa sản phẩm khỏi giỏ hàng
  void _removeFromCart(int index) {
    setState(() {
      _cartList.removeAt(index);
    });
  }

  // Tính tổng tiền
  double get _totalPrice {
    return _cartList.fold(0, (sum, item) => sum + (item.price * item.quantity));
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Shoe Store'),
        backgroundColor: Colors.blue,
      ),
      body: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Tiêu đề Giỏ hàng
          const Padding(
            padding: EdgeInsets.all(12.0),
            child: Text(
              'Giỏ hàng',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
          ),

          // Danh sách giỏ hàng
          Expanded(
            child: _cartList.isEmpty
                ? const Center(child: Text('Giỏ hàng trống'))
                : ListView.builder(
                    itemCount: _cartList.length,
                    itemBuilder: (context, index) {
                      return CartItemWidget(
                        product: _cartList[index],
                        onDelete: () => _removeFromCart(index),
                      );
                    },
                  ),
          ),

          // Hiển thị tổng tiền
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                const Text(
                  'Tổng tiền:',
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                ),
                Text(
                  '${_totalPrice.toStringAsFixed(2)} \$',
                  style: const TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    color: Colors.red,
                  ),
                ),
              ],
            ),
          ),

          const Divider(thickness: 1),

          // Tiêu đề Danh sách giày
          const Padding(
            padding: EdgeInsets.all(12.0),
            child: Text(
              'Danh sách giày',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
          ),

          // Danh sách sản phẩm cuộn ngang
          SizedBox(
            height: 180,
            child: ListView.builder(
              scrollDirection: Axis.horizontal,
              padding: const EdgeInsets.only(left: 12, bottom: 12),
              itemCount: _products.length,
              itemBuilder: (context, index) {
                return ProductCardWidget(
                  product: _products[index],
                  onAddToCart: () => _addToCart(_products[index]),
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}

